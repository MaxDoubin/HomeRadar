#!/bin/sh
set -eu

cd /opt/homeradar
python3 -m venv .venv
.venv/bin/python -m pip install --no-cache-dir -r backend/requirements.txt
npm --prefix frontend install
npm --prefix frontend run build

# deploy/homeradar.service runs as this user; mirror scripts/setup.sh.
if ! getent group homeradar >/dev/null; then
  groupadd --system homeradar
fi
if ! id -u homeradar >/dev/null 2>&1; then
  useradd --system --gid homeradar --home-dir /var/lib/homeradar --shell /usr/sbin/nologin homeradar
fi

install -d -m 0755 -o root -g root /etc/homeradar
install -d -m 0750 -o homeradar -g homeradar /var/lib/homeradar
cp deploy/homeradar.env.example /etc/homeradar/homeradar.env
chown root:homeradar /etc/homeradar/homeradar.env
chmod 0640 /etc/homeradar/homeradar.env
cp deploy/homeradar.service /etc/systemd/system/
cp deploy/homeradar-blocklists.service /etc/systemd/system/
cp deploy/homeradar-blocklists.timer /etc/systemd/system/
systemctl enable homeradar.service homeradar-blocklists.timer

cat >/etc/xdg/openbox/autostart <<'EOF'
xset -dpms
xset s off
chromium --kiosk --no-first-run http://127.0.0.1:8000/kiosk/status-display.html &
EOF

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the local HomeRadar appliance over the LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Local notifications for newly-appeared alerts (Android 13+ requires this at runtime too). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HomeRadarApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.HomeRadar"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is required: the appliance is reached over plain
          http:// on the local network (e.g. "homeradar.local:8000"), not https.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HomeRadar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

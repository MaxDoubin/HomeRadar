HOMERADAR_DB_PATH=/var/lib/homeradar/homeradar.db
HOMERADAR_DATA_DIR=/var/lib/homeradar
HOMERADAR_BACKUP_DIR=/var/lib/homeradar/backups

HOMERADAR_API_HOST=0.0.0.0
HOMERADAR_API_PORT=8000
# Same-origin dashboard access needs no CORS entry. List only exact trusted
# origins separated by commas if a separate browser frontend is deliberately used.
HOMERADAR_CORS_ORIGINS=

HOMERADAR_DNS_ENABLED=true
HOMERADAR_DNS_HOST=0.0.0.0
HOMERADAR_DNS_PORT=53
HOMERADAR_DNS_ALLOW_PUBLIC_CLIENTS=false
HOMERADAR_DNS_UPSTREAM=1.1.1.1
HOMERADAR_DNS_UPSTREAMS=1.1.1.1,9.9.9.9
HOMERADAR_DNS_CACHE_SIZE=4096
HOMERADAR_DNS_CACHE_MAX_TTL=3600
HOMERADAR_BLOCKLIST_AUTO_UPDATE=false

# Passive packet capture is optional. The hardened systemd service grants only
# CAP_NET_RAW and CAP_NET_BIND_SERVICE, so leave this disabled unless you review
# and deliberately extend the service capabilities for your network interface.
HOMERADAR_TRAFFIC_MONITOR_ENABLED=false
HOMERADAR_TRAFFIC_INTERFACE=

HOMERADAR_TRAFFIC_RETENTION_DAYS=30
HOMERADAR_ALERT_RETENTION_DAYS=180
HOMERADAR_BACKUP_RETENTION_COUNT=7
HOMERADAR_HOUSEHOLD_NAME=My Home
HOMERADAR_PUBLIC_URL=http://homeradar.local:8000

HOMERADAR_ABUSEIPDB_API_KEY=
HOMERADAR_SMTP_HOST=
HOMERADAR_SMTP_PORT=587
HOMERADAR_SMTP_USERNAME=
HOMERADAR_SMTP_PASSWORD=
HOMERADAR_SMTP_FROM=
HOMERADAR_SMTP_TO=
HOMERADAR_SMTP_USE_TLS=true

[Unit]
Description=Home Radar network security appliance
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=homeradar
Group=homeradar
WorkingDirectory=/opt/homeradar
EnvironmentFile=-/etc/homeradar/homeradar.env
ExecStart=/opt/homeradar/.venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET
SystemCallArchitectures=native
ReadWritePaths=/var/lib/homeradar

[Install]
WantedBy=multi-user.target

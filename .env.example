# Copy to .env before running Docker Compose.
HOMERADAR_HOUSEHOLD_NAME=My Home
HOMERADAR_DNS_UPSTREAM=1.1.1.1
HOMERADAR_DNS_UPSTREAMS=1.1.1.1,9.9.9.9
HOMERADAR_DNS_CACHE_SIZE=4096
HOMERADAR_DNS_CACHE_MAX_TTL=3600
HOMERADAR_TRAFFIC_RETENTION_DAYS=30
HOMERADAR_ALERT_RETENTION_DAYS=180
HOMERADAR_BACKUP_RETENTION_COUNT=7

# Browser cross-origin access is disabled by default. Usually leave this blank
# because the dashboard and API share the same origin. If a separate trusted web
# frontend is used, list exact origins separated by commas (never use *).
HOMERADAR_CORS_ORIGINS=

# Passive packet capture is optional and disabled in the hardened Compose file.
# It may require NET_ADMIN in addition to the default NET_RAW capability.
HOMERADAR_TRAFFIC_MONITOR_ENABLED=false
HOMERADAR_TRAFFIC_INTERFACE=

# Optional reputation and email providers
HOMERADAR_ABUSEIPDB_API_KEY=
HOMERADAR_SMTP_HOST=
HOMERADAR_SMTP_PORT=587
HOMERADAR_SMTP_USERNAME=
HOMERADAR_SMTP_PASSWORD=
HOMERADAR_SMTP_FROM=
HOMERADAR_SMTP_TO=
